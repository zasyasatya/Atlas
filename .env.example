# ---- copy to .env and fill in ----------------------------------------------
# Branding (optional)
# The public identity of the platform. Everything user-facing reads these four
# values - the browser tab title, the sign-in card, the sidebar, the CLI banner
# and the manual footer - so renaming the product for a client or a programme is
# an env change here and never a rebuild of the frontend bundle.
ATLAS_APP_NAME=ATLAS
ATLAS_APP_TAGLINE=Applied AI & Data Research Platform
# Small caps line under the wordmark.
ATLAS_APP_TAGLINE_SHORT=Applied AI Platform
# The sentence on the sign-in screen.
ATLAS_APP_SUBTITLE=Datasets, models and live apps in one place - from the first notebook to a deployed app on your own domain.
# Optional: your own docs site. Empty means the built-in manual at /manual.
ATLAS_DOCS_URL=

# Core
# production hides setup/settings/troubleshooting docs and the demo credentials.
# Only development/dev/local/test/testing unlock them; anything else = production.
ATLAS_ENVIRONMENT=production
ATLAS_SECRET_KEY=generate-a-long-random-string
ATLAS_PUBLIC_BASE_URL=https://atlas.yourdomain.com   # remote notebooks call back here
ATLAS_SEED_DEMO_DATA=true

# Database (leave empty for SQLite under ./storage)
# ATLAS_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/atlas

# Colab GPU bridge (optional but recommended)
ATLAS_GITHUB_TOKEN=
ATLAS_COLAB_GITHUB_REPO=your-org/atlas-notebooks
ATLAS_COLAB_GITHUB_BRANCH=main

# Kaggle GPU bridge (optional - enables fully headless GPU training)
ATLAS_KAGGLE_USERNAME=
ATLAS_KAGGLE_KEY=

# Deployment engine: local_process | coolify | manifest
ATLAS_DEPLOY_DRIVER=local_process
# Apps are served as virtual directories under this prefix on the main domain,
# e.g. prefix "app" + slug "my-app" -> https://<domain>/app/my-app
ATLAS_DEPLOY_URL_PREFIX=app
# ATLAS serves those paths itself, proxying /<prefix>/<slug>/ (HTTP and
# WebSocket) to the app's internal port. This is what makes a deployed app
# openable with nothing installed, so it should only be turned off when another
# proxy already owns that path on the ATLAS port.
ATLAS_DEPLOY_BUILTIN_PROXY=true
# A deploy already publishes the route; this is how long a slug is re-resolved
# from the database afterwards, in seconds.
ATLAS_DEPLOY_ROUTE_TTL_SECONDS=2
ATLAS_COOLIFY_BASE_URL=
ATLAS_COOLIFY_TOKEN=
ATLAS_COOLIFY_PROJECT_UUID=
ATLAS_COOLIFY_SERVER_UUID=

# Reverse proxy (nginx) - OPTIONAL. Apps are already reachable through ATLAS
# itself (see ATLAS_DEPLOY_BUILTIN_PROXY). Configure this only when something has
# to sit in front of the platform: TLS, rate limits, static assets, or a host
# where nginx is the only thing bound to :80.
#
# ATLAS writes one managed <location> snippet per app and reloads nginx after
# validating it, touching nothing it does not own; each app's data/caches stay
# isolated in storage/appdata/<id>_<slug>/ on persistent storage.
#   * Leave these blank: the snippets + a ready-to-install atlas.conf are kept
#     under ./storage/nginx (download via Portal -> "App routing").
#   * Opt in to having the vhost installed inside nginx for you: it is written to
#     sites-available + linked into sites-enabled (or conf.d), only over a file
#     ATLAS owns, and rolled back if `nginx -t` rejects it.
# ATLAS_NGINX_AUTO_INSTALL=true
# ATLAS_NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
# ATLAS_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
# ATLAS_NGINX_CONF_D=/etc/nginx/conf.d
#   * For fully automatic reloads, point these at a live nginx:
# ATLAS_NGINX_CONF_DIR=/etc/nginx/apps.d            # one managed snippet per app
# ATLAS_NGINX_VHOST_FILE=/etc/nginx/sites-available/atlas.conf
# ATLAS_NGINX_RELOAD_CMD=sudo nginx -s reload       # or: docker exec <proxy> nginx -s reload
# ATLAS_NGINX_AUTO_RELOAD=true
# ATLAS_NGINX_UPSTREAM=http://127.0.0.1:8000        # where the portal/API listens

# Google SSO (optional). Both values are required - the button stays disabled
# until each is set. In Google Cloud Console create an OAuth 2.0 Client ID of
# type "Web application" and add this authorised redirect URI:
#     https://<your-domain>/api/auth/google/callback
# ATLAS_PUBLIC_BASE_URL must match <your-domain> exactly, or Google rejects the
# handshake with redirect_uri_mismatch.
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to one or more email domains, comma separated.
# Empty means any verified Google account may sign in, landing as an Intern.
ATLAS_GOOGLE_ALLOWED_DOMAINS=
