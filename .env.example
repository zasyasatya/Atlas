# ---- copy to .env and fill in ----------------------------------------------
# Core
# production hides setup/settings/troubleshooting docs and the demo credentials.
# Only development/dev/local/test/testing unlock them; anything else = production.
ATLAS_ENVIRONMENT=production
ATLAS_SECRET_KEY=generate-a-long-random-string
ATLAS_PUBLIC_BASE_URL=https://atlas.yourdomain.com   # remote notebooks call back here
ATLAS_SEED_DEMO_DATA=true

# Database (leave empty for SQLite under ./storage)
# ATLAS_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/atlas

# Colab GPU bridge (optional but recommended)
ATLAS_GITHUB_TOKEN=
ATLAS_COLAB_GITHUB_REPO=your-org/atlas-notebooks
ATLAS_COLAB_GITHUB_BRANCH=main

# Kaggle GPU bridge (optional - enables fully headless GPU training)
ATLAS_KAGGLE_USERNAME=
ATLAS_KAGGLE_KEY=

# Deployment engine: local_process | coolify | manifest
ATLAS_DEPLOY_DRIVER=local_process
# Apps are served as virtual directories under this prefix on the main domain,
# e.g. prefix "app" + slug "my-app" -> https://<domain>/app/my-app
ATLAS_DEPLOY_URL_PREFIX=app
ATLAS_COOLIFY_BASE_URL=
ATLAS_COOLIFY_TOKEN=
ATLAS_COOLIFY_PROJECT_UUID=
ATLAS_COOLIFY_SERVER_UUID=

# Reverse proxy (nginx) automation. Deployed apps automatically get their own
# nginx <location> block so they are reachable as virtual directories, and nginx
# is validated + gracefully reloaded without touching other sites. Each app's
# data/caches are also isolated into storage/appdata/<id>_<slug>/ on persistent
# storage.
#   * Leave these blank: ATLAS writes the snippets + a ready-to-install
#     atlas.conf under ./storage/nginx (download via Portal -> "Reverse proxy").
#   * For fully automatic reloads, point these at a live nginx:
# ATLAS_NGINX_CONF_DIR=/etc/nginx/apps.d            # one managed snippet per app
# ATLAS_NGINX_VHOST_FILE=/etc/nginx/sites-available/atlas.conf
# ATLAS_NGINX_RELOAD_CMD=sudo nginx -s reload       # or: docker exec <proxy> nginx -s reload
# ATLAS_NGINX_AUTO_RELOAD=true
# ATLAS_NGINX_UPSTREAM=http://127.0.0.1:8000        # where the portal/API listens

# Google SSO (optional). Both values are required - the button stays disabled
# until each is set. In Google Cloud Console create an OAuth 2.0 Client ID of
# type "Web application" and add this authorised redirect URI:
#     https://<your-domain>/api/auth/google/callback
# ATLAS_PUBLIC_BASE_URL must match <your-domain> exactly, or Google rejects the
# handshake with redirect_uri_mismatch.
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to one or more email domains, comma separated.
# Empty means any verified Google account may sign in, landing as an Intern.
ATLAS_GOOGLE_ALLOWED_DOMAINS=
